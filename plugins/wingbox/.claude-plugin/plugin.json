{
  "name": "wingbox",
  "displayName": "Wingbox",
  "version": "0.19.2",
  "description": "A map of your codebase for coding agents: what a change touches, where a symbol is used.",
  "author": {
    "name": "Aileron Technologies",
    "url": "https://wingbox.dev"
  },
  "homepage": "https://wingbox.dev",
  "repository": "https://github.com/aileron-tech/wingbox",
  "license": "MIT",
  "keywords": [
    "code-graph",
    "blast-radius",
    "impact-analysis",
    "dependency-graph",
    "code-search",
    "architecture",
    "local-first",
    "mcp",
    "monorepo",
    "large-codebase",
    "codebase-map",
    "call-graph",
    "refactoring",
    "code-navigation"
  ],
  "icon": "./assets/icon.png",
  "documentationUrl": "https://github.com/aileron-tech/wingbox#readme",
  "supportUrl": "https://github.com/aileron-tech/wingbox/issues",
  "privacyPolicyUrl": "https://github.com/aileron-tech/wingbox/blob/main/docs/store/PRIVACY.md",
  "termsOfServiceUrl": "https://github.com/aileron-tech/wingbox/blob/main/LICENSE",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--offline",
              "--quiet",
              "--from",
              "git+https://github.com/aileron-tech/wingbox@73484f4d265e8c071f725066ce54ac6b2622bea5",
              "wingbox",
              "hook",
              "pre-search"
            ],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--offline",
              "--quiet",
              "--from",
              "git+https://github.com/aileron-tech/wingbox@73484f4d265e8c071f725066ce54ac6b2622bea5",
              "wingbox",
              "hook",
              "dirty"
            ],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--offline",
              "--quiet",
              "--from",
              "git+https://github.com/aileron-tech/wingbox@73484f4d265e8c071f725066ce54ac6b2622bea5",
              "wingbox",
              "hook",
              "git"
            ],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--offline",
              "--quiet",
              "--from",
              "git+https://github.com/aileron-tech/wingbox@73484f4d265e8c071f725066ce54ac6b2622bea5",
              "wingbox",
              "hook",
              "session-start"
            ],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "wingbox": {
      "command": "uvx",
      "args": [
        "--quiet",
        "--from",
        "git+https://github.com/aileron-tech/wingbox@73484f4d265e8c071f725066ce54ac6b2622bea5",
        "wingbox",
        "mcp"
      ]
    }
  }
}
