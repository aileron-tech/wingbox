{
  "name": "wingbox",
  "displayName": "Wingbox",
  "version": "0.3.0",
  "description": "Code graph for large repositories and monorepos: what a change will break (blast radius), who depends on a file, module boundaries and the few files to read first. Python, TypeScript, Rust, C#, Java, Go, Ruby. Runs on your machine; no code leaves it.",
  "author": {
    "name": "Aileron Technologies",
    "url": "https://wingbox.dev"
  },
  "homepage": "https://wingbox.dev",
  "repository": "https://github.com/aileron-tech/wingbox",
  "license": "MIT",
  "keywords": [
    "code-graph",
    "blast-radius",
    "impact-analysis",
    "dependency-graph",
    "code-search",
    "architecture",
    "local-first",
    "mcp",
    "monorepo",
    "large-codebase",
    "codebase-map",
    "call-graph",
    "refactoring",
    "code-navigation"
  ],
  "icon": "./assets/icon.png",
  "documentationUrl": "https://github.com/aileron-tech/wingbox#readme",
  "supportUrl": "https://github.com/aileron-tech/wingbox/issues",
  "privacyPolicyUrl": "https://github.com/aileron-tech/wingbox/blob/main/docs/store/PRIVACY.md",
  "termsOfServiceUrl": "https://github.com/aileron-tech/wingbox/blob/main/LICENSE",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/wingbox-run\" hook pre-search",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/wingbox-run\" hook dirty",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "wingbox": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/wingbox-run",
        "mcp"
      ]
    }
  }
}
